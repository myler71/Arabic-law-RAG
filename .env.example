# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Offline / Local AI RAG Configuration (Promoted legalassist-ai)
LEGAL_RAG_BASE_URL=http://127.0.0.1:8000
LEGAL_RAG_SERVICE_KEY=your-internal-rag-secret-key

# Local Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# External LLM Adapters (Optional Fallbacks)
KARNAK_API_URL=
KARNAK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# LLMOps Evaluation & LLM-as-Judge (Spec L6.3, L6.5)
LLM_JUDGE_PROVIDER=groq
LLM_JUDGE_MODEL=qwen/qwen3.8-27b

# LLMOps Tracing & Observability (Spec L3.1, L4)
OTLP_ENDPOINT=http://localhost:4318/v1/traces
LANGSMITH_API_KEY=

# LLMOps Dev Isolation & Runs Store (Spec L5.5)
LLMOPS_RUNS_FILE=evaluation/reports/runs.jsonl

# Feature Flags (Spec L7.2)
FF_AI_STREAMING=true
FF_AI_RAG_PRIMARY=true
FF_AI_LANGMEM_INJECT=true
FF_AI_CASE_DEEP=false
FF_AI_ONLINE_JUDGE_SAMPLE=false
FF_AI_DEMO_KEYWORD_FALLBACK=false

# Application Mode
AI_MODE=offline
ENABLE_AI_STREAMING=true
